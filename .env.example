# Local server port
PORT=3001
NODE_ENV=development

# Optional persistent storage. Use a PostgreSQL connection string for online hosting.
DATABASE_URL=

# Optional LiveKit voice chat. Leave blank to use in-game text chat only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional comma-separated list of allowed browser origins in production.
# Example: CLIENT_ORIGIN=https://your-game.example.com
CLIENT_ORIGIN=
