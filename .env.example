# Local server port
PORT=3001
NODE_ENV=development

# Optional persistent storage. Use a PostgreSQL connection string for online hosting.
DATABASE_URL=
# PostgreSQL TLS verification is enabled by default when DATABASE_URL is set.
# For local development only, set DATABASE_SSL=disable if your local Postgres has no TLS.
DATABASE_SSL=
# Optional provider CA certificate, if your database provider requires a custom trust root.
# Supply PEM text in DATABASE_SSL_CA, or base64-encoded PEM in DATABASE_SSL_CA_BASE64.
DATABASE_SSL_CA=
DATABASE_SSL_CA_BASE64=

# Optional LiveKit voice chat. Leave blank to use in-game text chat only.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional comma-separated list of allowed browser origins in production.
# Example: CLIENT_ORIGIN=https://your-game.example.com
CLIENT_ORIGIN=
