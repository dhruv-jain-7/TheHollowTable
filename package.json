{
  "name": "the-hollow-table",
  "version": "1.0.0",
  "private": true,
  "description": "Private-code online social deduction horror game",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.25",
    "@livekit/components-styles": "^1.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.13.3",
    "pg": "^8.16.3",
    "dotenv": "^16.6.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
